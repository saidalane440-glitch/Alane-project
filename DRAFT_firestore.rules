rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) && 
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.role == 'student' && // Default role
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidFile(data) {
      return data.keys().hasAll(['id', 'name', 'type', 'size', 'url', 'category', 'ownerId', 'createdAt']) &&
             data.keys().size() == 8 &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 255 &&
             data.size is number && data.size >= 0 &&
             data.url is string && data.url.size() <= 1000;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /files/{fileId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isOwner(existing().ownerId);
      allow create: if isSignedIn() && isValidId(fileId) && isValidFile(incoming());
      allow update: if isOwner(existing().ownerId) && isValidFile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category']);
      allow delete: if isOwner(existing().ownerId);
    }

    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isOwner(existing().ownerId);
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwner(existing().ownerId) && isValidProject(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'thumbnailUrl', 'demoUrl', 'updatedAt']);
      allow delete: if isOwner(existing().ownerId);
    }
  }
}
